<Window
    x:Class="Layers.UI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Layers Settings">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Bar With The App Icon And The Pane Toggle (Icon Set In Code) -->
        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            Title="Layers Settings"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="AppTitleBar_PaneToggleRequested">

            <!-- As Tall As The Tall Caption Buttons, With A Square Pane Toggle (48 Less Its 2 DIP Margins) -->
            <TitleBar.Resources>
                <x:Double x:Key="TitleBarCompactHeight">48</x:Double>
                <x:Double x:Key="TitleBarPaneToggleButtonWidth">44</x:Double>
            </TitleBar.Resources>
        </TitleBar>

        <!-- Navigation Drawer -->
        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            OpenPaneLength="160"
            IsSettingsVisible="False"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            AlwaysShowHeader="False"
            SelectionChanged="Nav_SelectionChanged">

            <!-- Pane Items (General, And About At The Bottom) Are Set In Code -->

            <!-- Pages (General And About), Drilled In On Each Selection -->
            <Frame
                x:Name="ContentFrame"
                IsNavigationStackEnabled="False" />
        </NavigationView>
        <!-- /Navigation Drawer -->
    </Grid>
</Window>
