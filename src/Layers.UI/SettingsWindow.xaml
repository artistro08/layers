<Window
    x:Class="Layers.UI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Layers Settings">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Bar With The App Icon And The Pane Toggle (Icon Set In Code) -->
        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            Title="Layers Settings"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="AppTitleBar_PaneToggleRequested">

            <!-- As Tall As The Caption Buttons, With A Square Pane Toggle (48 Less Its 2 DIP Margins) -->
            <!-- No Spare Drag Strip Right Of The Caption Buttons, So Close Sits On The Window's Edge -->
            <!-- No Half Fade While Inactive, Which Would Also Fade The Caption Buttons -->
            <!-- They Dim Their Glyphs Instead, Like The Stock Ones -->
            <TitleBar.Resources>
                <x:Double x:Key="TitleBarCompactHeight">48</x:Double>
                <x:Double x:Key="TitleBarPaneToggleButtonWidth">44</x:Double>
                <x:Double x:Key="TitleBarMinDragRegionWidth">0</x:Double>
                <x:Double x:Key="TitleBarDeactivatedOpacity">1</x:Double>
            </TitleBar.Resources>

            <!-- Caption Buttons: Minimize And Close Only, Drawn Here Since Windows Can't Hide Maximize Alone -->
            <!-- Stock Buttons Restyled Through Their Resources To Match The Stock Windows 11 Caption Buttons -->
            <TitleBar.RightHeader>
                <StackPanel
                    x:Name="CaptionButtons"
                    Orientation="Horizontal">
                    <StackPanel.Resources>
                        <ResourceDictionary>

                            <!-- Shared Shape: Square, Borderless, Glyph Only -->
                            <Style
                                x:Key="CaptionButtonStyle"
                                TargetType="Button"
                                BasedOn="{StaticResource DefaultButtonStyle}">
                                <Setter Property="Width" Value="48" />
                                <Setter Property="Height" Value="48" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="CornerRadius" Value="0" />
                                <Setter Property="VerticalAlignment" Value="Top" />
                            </Style>

                            <!-- Shared Fills: Clear At Rest, Stock Subtle Fills On Hover And Press -->
                            <!-- The Glyph Stays Full Strength On Press, Like The Stock Ones -->
                            <!-- Per Theme, So A Theme Change Follows (Light Uses Default) -->
                            <!-- High Contrast: The System Highlight On Hover And Press, Like Close -->
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Default">
                                    <StaticResource
                                        x:Key="ButtonBackground"
                                        ResourceKey="SubtleFillColorTransparentBrush" />
                                    <StaticResource
                                        x:Key="ButtonBackgroundPointerOver"
                                        ResourceKey="SubtleFillColorSecondaryBrush" />
                                    <StaticResource
                                        x:Key="ButtonBackgroundPressed"
                                        ResourceKey="SubtleFillColorTertiaryBrush" />
                                    <StaticResource
                                        x:Key="ButtonForegroundPressed"
                                        ResourceKey="TextFillColorPrimaryBrush" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="HighContrast">
                                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                                    <SolidColorBrush
                                        x:Key="ButtonBackgroundPointerOver"
                                        Color="{ThemeResource SystemColorHighlightColor}" />
                                    <SolidColorBrush
                                        x:Key="ButtonBackgroundPressed"
                                        Color="{ThemeResource SystemColorHighlightColor}" />
                                    <SolidColorBrush
                                        x:Key="ButtonForegroundPointerOver"
                                        Color="{ThemeResource SystemColorHighlightTextColor}" />
                                    <SolidColorBrush
                                        x:Key="ButtonForegroundPressed"
                                        Color="{ThemeResource SystemColorHighlightTextColor}" />
                                </ResourceDictionary>
                            </ResourceDictionary.ThemeDictionaries>
                        </ResourceDictionary>
                    </StackPanel.Resources>

                    <!-- Minimize -->
                    <Button
                        x:Name="MinimizeButton"
                        Style="{StaticResource CaptionButtonStyle}"
                        Click="MinimizeButton_Click"
                        AutomationProperties.Name="Minimize">
                        <FontIcon
                            FontSize="10"
                            Glyph="&#xE921;" />
                    </Button>

                    <!-- Close: Stock Red With A White Glyph On Hover And Press -->
                    <Button
                        x:Name="CloseButton"
                        Style="{StaticResource CaptionButtonStyle}"
                        Click="CloseButton_Click"
                        AutomationProperties.Name="Close">
                        <Button.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Default">
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#C42B1C" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#E6C42B1C" />
                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="HighContrast">
                                        <SolidColorBrush
                                            x:Key="ButtonBackgroundPointerOver"
                                            Color="{ThemeResource SystemColorHighlightColor}" />
                                        <SolidColorBrush
                                            x:Key="ButtonBackgroundPressed"
                                            Color="{ThemeResource SystemColorHighlightColor}" />
                                        <SolidColorBrush
                                            x:Key="ButtonForegroundPointerOver"
                                            Color="{ThemeResource SystemColorHighlightTextColor}" />
                                        <SolidColorBrush
                                            x:Key="ButtonForegroundPressed"
                                            Color="{ThemeResource SystemColorHighlightTextColor}" />
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries>
                            </ResourceDictionary>
                        </Button.Resources>
                        <FontIcon
                            FontSize="10"
                            Glyph="&#xE8BB;" />
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>
            <!-- /Caption Buttons -->
        </TitleBar>

        <!-- Navigation Drawer -->
        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            OpenPaneLength="160"
            IsSettingsVisible="False"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            AlwaysShowHeader="False"
            SelectionChanged="Nav_SelectionChanged">

            <!-- Pane Items (General, And About At The Bottom) Are Set In Code -->

            <!-- Pages (General And About), Drilled In On Each Selection -->
            <Frame
                x:Name="ContentFrame"
                IsNavigationStackEnabled="False" />
        </NavigationView>
        <!-- /Navigation Drawer -->
    </Grid>
</Window>
