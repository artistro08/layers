<UserControl
    x:Class="Layers.UI.HudFace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Layers.UI"
    MinWidth="127">

    <!-- Stock Flyout Border, Filled With The Control's Background (Transparent Over The HUD's Live Acrylic) -->
    <Border
        CornerRadius="6"
        Background="{x:Bind Background, Mode=OneWay}"
        BorderBrush="{ThemeResource FlyoutBorderThemeBrush}"
        BorderThickness="{ThemeResource FlyoutBorderThemeThickness}">

        <!-- Icon And Label, Centered As A Group -->
        <StackPanel
            Margin="16,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="10">
            <PathIcon
                Width="16"
                Height="16"
                Data="{x:Bind local:Glyphs.Layers(16)}" />
            <TextBlock
                x:Name="Label"
                FontSize="15"
                VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
