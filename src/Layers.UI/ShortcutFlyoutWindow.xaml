<Window
    x:Class="Layers.UI.ShortcutFlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Layers.UI"
    Title="Layers">

    <!-- Transparent Window, So Only The Panel Shows -->
    <Window.SystemBackdrop>
        <local:TransparentBackdrop />
    </Window.SystemBackdrop>

    <!-- Window Root: The Margin Around The Panel Is Part Of The Window, So The Window's Edge At The Taskbar Is
         Where The Sliding Panel Gets Cut Off -->
    <Grid
        x:Name="WindowRoot"
        Padding="12">

        <!-- Slide Host: Moves In And Out; The Panel Inside Keeps Its Own Depth For The Shadow -->
        <Grid x:Name="SlideHost">

            <!-- Panel -->
            <Grid
                x:Name="Panel"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Translation="0,0,32">
                <Grid.Shadow>
                    <ThemeShadow />
                </Grid.Shadow>

                <!-- Acrylic Background -->
                <SystemBackdropElement CornerRadius="8">
                    <SystemBackdropElement.SystemBackdrop>
                        <local:ActiveAcrylicBackdrop />
                    </SystemBackdropElement.SystemBackdrop>
                </SystemBackdropElement>

                <!-- Sheet View (Added In Code). The StackPanel Offers Unbounded Height, So The View Takes Its Natural
                     Height (Capped By Its MaxHeight) Instead Of The Panel's Current Height, And The Panel's Height Can
                     Animate Toward It -->
                <StackPanel VerticalAlignment="Top">
                    <ContentPresenter x:Name="ViewHost" />
                </StackPanel>
            </Grid>
            <!-- /Panel -->
        </Grid>
        <!-- /Slide Host -->
    </Grid>
</Window>
