<UserControl
    x:Class="Layers.UI.ShortcutSheetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Layers.UI"
    KeyboardAcceleratorPlacementMode="Hidden">

    <UserControl.Resources>
        <!-- Footer Buttons: Icon Only, Quiet Until Hovered -->
        <Style
            x:Key="FooterIconButtonStyle"
            TargetType="Button"
            BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
    </UserControl.Resources>

    <!-- Esc Closes The Flyout -->
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="Escape_Invoked" />
    </UserControl.KeyboardAccelerators>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: A Band Like The Footer, With The Title, Search, And The Refresh Note Under Them -->
        <Border
            Grid.Row="0"
            Padding="16,12,16,12"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <StackPanel Spacing="4">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Shortcuts" />
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        x:FieldModifier="internal"
                        Grid.Column="1"
                        Width="200"
                        PlaceholderText="Search"
                        QueryIcon="Find"
                        TextChanged="SearchBox_TextChanged"
                        AutomationProperties.Name="Search shortcuts" />
                </Grid>
                <TextBlock
                    x:Name="RefreshNote"
                    x:FieldModifier="internal"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    Text="Couldn't refresh"
                    Visibility="{x:Bind Model.ShowRefreshNote, Mode=OneWay}" />
            </StackPanel>
        </Border>
        <!-- /Header -->

        <!-- Body: The Sections, Or A Placeholder -->
        <Grid Grid.Row="1">
            <ScrollViewer
                x:Name="Scroller"
                VerticalScrollBarVisibility="Auto"
                Visibility="{x:Bind Model.ShowList, Mode=OneWay}">
                <StackPanel
                    x:Name="SectionsPanel"
                    Padding="12,12,12,12"
                    Spacing="8" />
            </ScrollViewer>
            <TextBlock
                x:Name="Placeholder"
                x:FieldModifier="internal"
                Margin="16,24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind Model.EmptyMessage, Mode=OneWay}"
                Visibility="{x:Bind Model.HasEmptyMessage, Mode=OneWay}" />
        </Grid>
        <!-- /Body -->

        <!-- Footer: Status On The Left, Edit And Settings On The Right -->
        <Grid
            Grid.Row="2"
            Height="48"
            Padding="16,0,8,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <PathIcon
                    Width="16"
                    Height="16"
                    Data="M 4,8 A 4,4 0 1 1 12,8 A 4,4 0 1 1 4,8 Z"
                    Foreground="{x:Bind local:TrayMenuHost.ToneBrush(Model.Tone), Mode=OneWay}" />
                <TextBlock
                    x:Name="StatusLabel"
                    x:FieldModifier="internal"
                    VerticalAlignment="Center"
                    Text="{x:Bind Model.StatusLabel, Mode=OneWay}" />
            </StackPanel>
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    x:Name="EditButton"
                    x:FieldModifier="internal"
                    Style="{StaticResource FooterIconButtonStyle}"
                    AutomationProperties.Name="Edit in browser"
                    ToolTipService.ToolTip="Edit in browser"
                    Click="Edit_Click">
                    <FontIcon FontSize="16" Glyph="&#xE70F;" />
                </Button>
                <Button
                    x:Name="SettingsButton"
                    x:FieldModifier="internal"
                    Style="{StaticResource FooterIconButtonStyle}"
                    AutomationProperties.Name="Settings"
                    ToolTipService.ToolTip="Settings"
                    Click="Settings_Click">
                    <FontIcon FontSize="16" Glyph="&#xE713;" />
                </Button>
            </StackPanel>
        </Grid>
        <!-- /Footer -->
    </Grid>
</UserControl>
