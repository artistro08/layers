    Ported from PowerToys: src/common/Common.UI.Controls/Controls/KeyVisual/KeyCharPresenter.xaml (https://github.com/microsoft/PowerToys).
    By way of MagicBuds, whose changes are kept: the unused Office and Copilot key styles are left out, and the glyph
    style uses the same FontSize-tall box as the text and Windows keys.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Layers.UI.Controls">

    <Style BasedOn="{StaticResource DefaultKeyCharPresenterStyle}" TargetType="controls:KeyCharPresenter" />

    <!-- Text -->
    <Style x:Key="DefaultKeyCharPresenterStyle" TargetType="controls:KeyCharPresenter">
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:KeyCharPresenter">
                    <Grid Height="{TemplateBinding FontSize}">
                        <TextBlock
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="{TemplateBinding FontSize}"
                            FontWeight="{TemplateBinding FontWeight}"
                            Text="{TemplateBinding Content}"
                            TextLineBounds="Tight" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Windows Logo, Scaled To The Text Height -->
    <Style
        x:Key="WindowsKeyCharPresenterStyle"
        BasedOn="{StaticResource DefaultKeyCharPresenterStyle}"
        TargetType="controls:KeyCharPresenter">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:KeyCharPresenter">
                    <Grid Height="{TemplateBinding FontSize}">
                        <Viewbox>
                            <PathIcon Data="M9 20H0V11H9V20ZM20 20H11V11H20V20ZM9 9H0V0H9V9ZM20 9H11V0H20V9Z" />
                        </Viewbox>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Solid Mouse And Media Icons, Each Drawn In The Same 24 x 24 Frame So They Scale To The Same Size -->
    <!-- Mouse, Left Button: Solid Body And Pressed Button, The Other Dimmed -->
    <Style
        x:Key="MouseLeftKeyCharPresenterStyle"
        BasedOn="{StaticResource DefaultKeyCharPresenterStyle}"
        TargetType="controls:KeyCharPresenter">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:KeyCharPresenter">
                    <Grid Height="{TemplateBinding FontSize}">
                        <Viewbox>
                            <Grid Width="24" Height="24">
                            <PathIcon Width="24" Height="24" Data="M5,11 H19 V16 A7,7 0 0 1 12,23 A7,7 0 0 1 5,16 Z M5,8 A7,7 0 0 1 11.5,1.02 V10 H5 Z" />
                            <PathIcon Width="24" Height="24" Opacity="0.4" Data="M12.5,1.02 A7,7 0 0 1 19,8 V10 H12.5 Z" />
                            </Grid>
                        </Viewbox>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Mouse, Right Button -->
    <Style
        x:Key="MouseRightKeyCharPresenterStyle"
        BasedOn="{StaticResource DefaultKeyCharPresenterStyle}"
        TargetType="controls:KeyCharPresenter">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:KeyCharPresenter">
                    <Grid Height="{TemplateBinding FontSize}">
                        <Viewbox>
                            <Grid Width="24" Height="24">
                            <PathIcon Width="24" Height="24" Data="M5,11 H19 V16 A7,7 0 0 1 12,23 A7,7 0 0 1 5,16 Z M12.5,1.02 A7,7 0 0 1 19,8 V10 H12.5 Z" />
                            <PathIcon Width="24" Height="24" Opacity="0.4" Data="M5,8 A7,7 0 0 1 11.5,1.02 V10 H5 Z" />
                            </Grid>
                        </Viewbox>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Mouse, Middle Button: The Wheel Solid Over Dimmed Buttons -->
    <Style
        x:Key="MouseMiddleKeyCharPresenterStyle"
        BasedOn="{StaticResource DefaultKeyCharPresenterStyle}"
        TargetType="controls:KeyCharPresenter">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:KeyCharPresenter">
                    <Grid Height="{TemplateBinding FontSize}">
                        <Viewbox>
                            <Grid Width="24" Height="24">
                            <PathIcon Width="24" Height="24" Data="M5,11 H19 V16 A7,7 0 0 1 12,23 A7,7 0 0 1 5,16 Z M10.75,3 H13.25 V9 H10.75 Z" />
                            <PathIcon Width="24" Height="24" Opacity="0.4" Data="M5,8 A7,7 0 0 1 11.5,1.02 V10 H5 Z M12.5,1.02 A7,7 0 0 1 19,8 V10 H12.5 Z" />
                            </Grid>
                        </Viewbox>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Volume Up: Speaker And Two Waves -->
    <Style
        x:Key="VolumeUpKeyCharPresenterStyle"
        BasedOn="{StaticResource DefaultKeyCharPresenterStyle}"
        TargetType="controls:KeyCharPresenter">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:KeyCharPresenter">
                    <Grid Height="{TemplateBinding FontSize}">
                        <Viewbox>
                            <Grid Width="24" Height="24">
                            <PathIcon Width="24" Height="24" Data="M2,9 H6 L11,4.5 V19.5 L6,15 H2 Z M14,8.6 A4.9,4.9 0 0 1 14,15.4 L13,14.4 A3.5,3.5 0 0 0 13,9.6 Z M16.8,5.8 A8.8,8.8 0 0 1 16.8,18.2 L15.8,17.2 A7.4,7.4 0 0 0 15.8,6.8 Z" />
                            </Grid>
                        </Viewbox>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Volume Down: Speaker And One Wave -->
    <Style
        x:Key="VolumeDownKeyCharPresenterStyle"
        BasedOn="{StaticResource DefaultKeyCharPresenterStyle}"
        TargetType="controls:KeyCharPresenter">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:KeyCharPresenter">
                    <Grid Height="{TemplateBinding FontSize}">
                        <Viewbox>
                            <Grid Width="24" Height="24">
                            <PathIcon Width="24" Height="24" Data="M2,9 H6 L11,4.5 V19.5 L6,15 H2 Z M14,8.6 A4.9,4.9 0 0 1 14,15.4 L13,14.4 A3.5,3.5 0 0 0 13,9.6 Z" />
                            </Grid>
                        </Viewbox>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Mute: Speaker And A Cross -->
    <Style
        x:Key="MuteKeyCharPresenterStyle"
        BasedOn="{StaticResource DefaultKeyCharPresenterStyle}"
        TargetType="controls:KeyCharPresenter">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:KeyCharPresenter">
                    <Grid Height="{TemplateBinding FontSize}">
                        <Viewbox>
                            <Grid Width="24" Height="24">
                            <PathIcon Width="24" Height="24" Data="M2,9 H6 L11,4.5 V19.5 L6,15 H2 Z M14.5,9.9 L15.9,8.5 L18,10.6 L20.1,8.5 L21.5,9.9 L19.4,12 L21.5,14.1 L20.1,15.5 L18,13.4 L15.9,15.5 L14.5,14.1 L16.6,12 Z" />
                            </Grid>
                        </Viewbox>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Play/Pause -->
    <Style
        x:Key="PlayPauseKeyCharPresenterStyle"
        BasedOn="{StaticResource DefaultKeyCharPresenterStyle}"
        TargetType="controls:KeyCharPresenter">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:KeyCharPresenter">
                    <Grid Height="{TemplateBinding FontSize}">
                        <Viewbox>
                            <Grid Width="24" Height="24">
                            <PathIcon Width="24" Height="24" Data="M2,5 L10,12 L2,19 Z M13,5 H16 V19 H13 Z M19,5 H22 V19 H19 Z" />
                            </Grid>
                        </Viewbox>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Stop -->
    <Style
        x:Key="StopKeyCharPresenterStyle"
        BasedOn="{StaticResource DefaultKeyCharPresenterStyle}"
        TargetType="controls:KeyCharPresenter">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:KeyCharPresenter">
                    <Grid Height="{TemplateBinding FontSize}">
                        <Viewbox>
                            <Grid Width="24" Height="24">
                            <PathIcon Width="24" Height="24" Data="M6,6 H18 V18 H6 Z" />
                            </Grid>
                        </Viewbox>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Next Track -->
    <Style
        x:Key="NextTrackKeyCharPresenterStyle"
        BasedOn="{StaticResource DefaultKeyCharPresenterStyle}"
        TargetType="controls:KeyCharPresenter">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:KeyCharPresenter">
                    <Grid Height="{TemplateBinding FontSize}">
                        <Viewbox>
                            <Grid Width="24" Height="24">
                            <PathIcon Width="24" Height="24" Data="M4,5 L14,12 L4,19 Z M16,5 H19 V19 H16 Z" />
                            </Grid>
                        </Viewbox>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Previous Track -->
    <Style
        x:Key="PreviousTrackKeyCharPresenterStyle"
        BasedOn="{StaticResource DefaultKeyCharPresenterStyle}"
        TargetType="controls:KeyCharPresenter">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:KeyCharPresenter">
                    <Grid Height="{TemplateBinding FontSize}">
                        <Viewbox>
                            <Grid Width="24" Height="24">
                            <PathIcon Width="24" Height="24" Data="M20,5 L10,12 L20,19 Z M5,5 H8 V19 H5 Z" />
                            </Grid>
                        </Viewbox>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segoe Fluent Glyph -->
    <Style
        x:Key="GlyphKeyCharPresenterStyle"
        BasedOn="{StaticResource DefaultKeyCharPresenterStyle}"
        TargetType="controls:KeyCharPresenter">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:KeyCharPresenter">
                    <Grid Height="{TemplateBinding FontSize}">
                        <Viewbox>
                            <FontIcon
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                FontSize="{TemplateBinding FontSize}"
                                FontWeight="{TemplateBinding FontWeight}"
                                Glyph="{TemplateBinding Content}" />
                        </Viewbox>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
