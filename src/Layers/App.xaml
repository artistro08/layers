<Application
    x:Class="Layers.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Stock Fluent Styles, Then The Key Cap Styles (Presenter First: KeyVisual's Default Style Reads It) -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Layers.UI/Styles/KeyCharPresenter.xaml" />
                <ResourceDictionary Source="ms-appx:///Layers.UI/Styles/KeyVisual.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
